<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterInfo.Pages.SettingPage"
             Title="SettingPage">
    <ScrollView>
        <VerticalStackLayout>
            <Grid BackgroundColor="{StaticResource Gray600}">
                <Button Text="戻る" ImageSource="arrow_back_icon_white.png" ContentLayout="Left" HorizontalOptions="Start" Clicked="OnReturnButtonClicked" />
                <Label Text="設定" FontSize="24"
                           TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalTextAlignment="Center"/>
                <Button Text="保存" ImageSource="save_icon_white.png" ContentLayout="Right" HorizontalOptions="End"
                        Command="{Binding ReloadCommand}"/>
            </Grid>

            <VerticalStackLayout>
                <Label Text="窓口Ａ"/>
                <Label Text="名称"/>
                <Entry Placeholder="" />
                <Label Text="確率"/>
                <Stepper Minimum="0" Maximum="100" Increment="1" />
                <Label Text="％"/>
                <Label Text="時間"/>
                <TimePicker />
                <TimePicker />
                <Label Text="間隔"/>
                <Stepper Minimum="1" Maximum="60" Increment="1" />
                <Label Text="範囲"/>
                <Entry Placeholder="" />
                <Picker Title="" />
                <HorizontalStackLayout>
                    <Button ImageSource="remove_icon_white.png" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
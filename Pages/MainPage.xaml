<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:CounterInfo.View"
             x:Class="CounterInfo.Pages.MainPage"
             NavigationPage.HasNavigationBar="false"
             >
    <ContentPage.Resources>
        <x:Int32 x:Key="BodySpacing">16</x:Int32> 
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout BackgroundColor="{StaticResource Gray100}">
            <!-- Header -->
            <Grid BackgroundColor="{StaticResource Gray600}">
                <Button Text="設定" ContentLayout="Left"  ImageSource="settings_icon_white.png"
                        Clicked="OnSettingButtonClicked"  HorizontalOptions="Start"/>
                <VerticalStackLayout HorizontalOptions="Center">
                    <VerticalStackLayout.Resources>
                        <Style TargetType="Label">
                            <Setter Property="HorizontalOptions" Value="Center"/>
                            <Setter Property="TextColor" Value="{StaticResource White}"/>
                        </Style>
                    </VerticalStackLayout.Resources>
                    <Label Text  ="窓口状況"   FontSize="24"/>
                    <Label x:Name="UpdateTime" FontSize="14"/>
                </VerticalStackLayout>
                <Button Text="更新" ContentLayout="Right" ImageSource="sync_icon_white.png"
                        Clicked="OnReloadButtonClicked"   HorizontalOptions="End"/>
            </Grid>

            <!-- Body -->
            <VerticalStackLayout Spacing="{StaticResource Key=BodySpacing}" Padding="{StaticResource Key=BodySpacing}">
                <view:NumberSearchWidget/>
                <view:CounterInfomationWidget/>
                <view:CalledWidget/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:CounterInfo.View"
             xmlns:model="clr-namespace:CounterInfo.Models"
             xmlns:viewModels="clr-namespace:CounterInfo.ViewModels"
             x:Class="CounterInfo.Pages.SettingMenuPage"
             x:DataType="viewModels:SettingMenuPageViewModel"
             NavigationPage.HasNavigationBar="false">
    <ContentPage.BindingContext>
        <viewModels:SettingMenuPageViewModel />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout>
            <!-- Header -->
            <Grid BackgroundColor="{StaticResource Gray600}">
                <Button Text="戻る" ImageSource="arrow_back_icon_white.png" ContentLayout="Left" HorizontalOptions="Start" Clicked="OnReturnButtonClicked" />
                <Label Text="設定" FontSize="24"
                           TextColor="{StaticResource White}" HorizontalOptions="Center" VerticalTextAlignment="Center"/>
                <Button Text="保存" ImageSource="save_icon_white.png" ContentLayout="Right" HorizontalOptions="End"
                        Command="{Binding ReloadCommand}"/>
            </Grid>
            
            <!-- Body -->
            <VerticalStackLayout BackgroundColor="{StaticResource Gray100}">
                <Label Text="範囲（予備）"/>
                <Entry Placeholder="" />
                <view:CounterListWidget/>
            </VerticalStackLayout>
        </VerticalStackLayout>        
    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CounterInfo.ViewModels"
             x:Class   ="CounterInfo.Pages.SettingPage"
             x:DataType="vm:SettingPageViewModel"
             NavigationPage.HasBackButton   ="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.BindingContext>
        <vm:SettingPageViewModel/>
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <x:Int32 x:Key="ItemSpacing">10</x:Int32>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout BackgroundColor="{StaticResource Gray100}">
            <!-- Header -->
            <Grid BackgroundColor="{StaticResource Gray600}">
                <VerticalStackLayout HorizontalOptions="Start">
                    <Button Text="破棄" ContentLayout="Left" ImageSource="remove_icon_white.png"
                            Clicked="BackButtonClicked"   IsVisible="{Binding AppendModeVisible}"
                            BackgroundColor="{StaticResource Magenta}"/>
                    <Button Text="戻る" ContentLayout="Left" ImageSource="arrow_back_icon_white.png"
                            Clicked="ReturnButtonClicked" IsVisible="{Binding ChangeModeVisible}"/>
                </VerticalStackLayout>            
                <Label Text="設定" FontSize="24" TextColor="{StaticResource White}"
                       HorizontalOptions="Center" VerticalTextAlignment="Center"/>
                <VerticalStackLayout HorizontalOptions="End">
                    <Button Text="保存" ContentLayout="Right" ImageSource="save_icon_white.png"
                            Clicked="SaveButtonClicked"   IsVisible="{Binding AppendModeVisible}"/>
                    <Button Text="削除" ContentLayout="Right" ImageSource="delete_icon_white.png"
                            Clicked="DeleteButtonClicked" IsVisible="{Binding ChangeModeVisible}"
                            BackgroundColor="{StaticResource Magenta}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- body -->
            <VerticalStackLayout>
                <VerticalStackLayout.Resources>
                    <ColumnDefinitionCollection x:Key="ColDefinition">
                        <ColumnDefinition Width= "*"/>
                        <ColumnDefinition Width="auto"/>
                    </ColumnDefinitionCollection>
                    <RowDefinitionCollection x:Key="RowDefinition">
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </RowDefinitionCollection>
                    <Style TargetType="Grid">
                        <Setter Property="ColumnDefinitions" Value="{StaticResource ColDefinition}"/>
                        <Setter Property=   "RowDefinitions" Value="{StaticResource RowDefinition}"/>
                        <Setter Property="RowSpacing" Value="{StaticResource ItemSpacing}"/>
                        <Setter Property="Margin"     Value="10,10,10,0"/>
                    </Style>
                    <Style TargetType="BoxView">
                        <Setter Property="Grid.Row"        Value="1"/>
                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                        <Setter Property="BackgroundColor" Value="{StaticResource Gray300}"/>
                        <Setter Property="HeightRequest" Value="2"/>
                        <Setter Property="Margin"        Value="0"/>
                    </Style>
                    <Style TargetType="Label" x:Key="Header">
                        <Setter Property="Grid.Row"    Value="0"/>
                        <Setter Property="Grid.Column" Value="0"/>
                        <Setter Property="VerticalOptions" Value="Center"   />
                        <Setter Property="FontSize"        Value="18"       />
                        <Setter Property="TextDecorations" Value="Underline"/>
                    </Style>
                    <Style TargetType="Label" x:Key="Normal">
                        <Setter Property="Grid.Row"    Value="0"/>
                        <Setter Property="Grid.Column" Value="0"/>
                        <Setter Property="VerticalOptions" Value="Center"/>
                        <Setter Property="FontSize"        Value="16"    />
                        <Setter Property="TextDecorations" Value="None"  />
                    </Style>
                </VerticalStackLayout.Resources>

                <Grid>
                    <Label Style="{StaticResource Header}" Text="名称" TextDecorations="Underline" />
                    <Entry Grid.Row="0" Grid.Column="1" Text="{Binding Name}" Placeholder="窓口Ａ"/>
                    <BoxView/>
                </Grid>
                <Grid>
                    <Label Style="{StaticResource Header}" Text="間隔"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource ItemSpacing}">
                        <HorizontalStackLayout Spacing="{StaticResource ItemSpacing}">
                            <Label   Text ="{Binding  IssueInterval, StringFormat='受付：{0}分'}" Style="{StaticResource Normal}"/>
                            <Stepper Value="{Binding  IssueInterval}" Minimum="1" Maximum="60" Increment="1"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="{StaticResource ItemSpacing}">
                            <Label   Text ="{Binding ReceptInterval, StringFormat='発行：{0}分'}" Style="{StaticResource Normal}"/>
                            <Stepper Value="{Binding ReceptInterval}" Minimum="1" Maximum="60" Increment="1" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <BoxView/>
                </Grid>
                <Grid>
                    <Label Text="不在確率" Style="{StaticResource Header}"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource ItemSpacing}">
                        <Label   Text ="{Binding AbsenceParcent, StringFormat='{0}％'}" Style="{StaticResource Normal}"/>
                        <Stepper Value="{Binding AbsenceParcent}" Minimum="0" Maximum="100" Increment="1" />
                    </HorizontalStackLayout>
                    <BoxView/>                    
                </Grid>
                <!--#region 仕様上動作していない？-->
                <!--<Grid>
                    <Label Text="発行範囲"  Style="{StaticResource Header}"/>
                    <HorizontalStackLayout Grid.Column="1" Spacing="{StaticResource ItemSpacing}">
                        <Label   Text ="{Binding Range, StringFormat='{0}から'}"  Style="{StaticResource Normal}"/>
                        <Stepper Value="{Binding Range}" Minimum="1" Maximum="4901" Increment="100" />
                    </HorizontalStackLayout>
                    <BoxView/>
                </Grid>-->
                <!--#endregion-->
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
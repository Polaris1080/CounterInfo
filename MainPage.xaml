<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CounterInfo.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25">
            <HorizontalStackLayout>
                <Button Text="設定"/>
                <Label Text="窓口情報" />
                <Button Text="更新" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Entry />
                <Button Text="検索"/>
                <Button Text="通知"/>
            </HorizontalStackLayout>

            <StackLayout></StackLayout>
            <Label Text="説明"/>
            <Border>
                <VerticalStackLayout>
                    <Border BackgroundColor="AliceBlue">
                        <Label Text="お呼び出し時ご不在の方"/>
                    </Border>
                    <Label Text="810"/>
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="CounterBtn"
                Text="Click me" 
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

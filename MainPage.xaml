<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:CounterInfo.Models"
             x:Class="CounterInfo.MainPage"
             
             >

    <ScrollView>
        <VerticalStackLayout
            Spacing="25">
            <HorizontalStackLayout>
                <Button Text="設定"/>
                <Label Text="窓口情報" />
                <Button Text="更新" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Entry />
                <Button Text="検索"/>
                <Button Text="通知"/>
            </HorizontalStackLayout>

            <StackLayout>
                <CollectionView>
                    <CollectionView.ItemsSource>
                        <x:Array Type="{x:Type model:Person }">
                            <model:Person Name="Steve" Age="21" Location="USA" />
                            <model:Person Name="John" Age="37" Location="USA" />
                            <model:Person Name="Tom" Age="42" Location="UK" />
                            <model:Person Name="Lucas" Age="29" Location="Germany" />
                            <model:Person Name="Tariq" Age="39" Location="UK" />
                            <model:Person Name="Jane" Age="30" Location="USA" />
                        </x:Array>
                    </CollectionView.ItemsSource>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Person">
                            <HorizontalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Age}" />
                                <Label Grid.Column="2" Text="{Binding Location}" HorizontalTextAlignment="End" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
            <Label Text="説明"/>
            <Border>
                <VerticalStackLayout>
                    <Border BackgroundColor="AliceBlue">
                        <Label Text="お呼び出し時ご不在の方"/>
                    </Border>
                    <Label Text="810"/>
                </VerticalStackLayout>
            </Border>

            <Button
                x:Name="CounterBtn"
                Text="Click me" 
                SemanticProperties.Hint="Counts the number of times you click"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

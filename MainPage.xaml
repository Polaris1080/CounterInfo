<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:CounterInfo.Models"
             xmlns:viewModels="clr-namespace:CounterInfo.ViewModels"
             x:Class="CounterInfo.MainPage"
             x:DataType="viewModels:MainPageViewModel"
             >
    <ContentPage.BindingContext>
        <viewModels:MainPageViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout BackgroundColor="{StaticResource Gray100}"
            Spacing="25">
            <HorizontalStackLayout BackgroundColor="{StaticResource Gray600}">
                <Button Text="設定"/>
                <Label Text="窓口情報" TextColor="{StaticResource White}"/>
                <Button Text="更新" />
            </HorizontalStackLayout>
            <HorizontalStackLayout>
                <Entry Keyboard="Numeric" Text="{Binding Search, Mode=TwoWay}"/>
                <Button Text="検索" Command="{Binding SearchCommand}"/>
                <Button Text="通知" Command="{Binding NoticeCommand}"/>
                <Label Text="{Binding Status, Mode=OneWay}"/>
            </HorizontalStackLayout>

            <StackLayout>
                <CollectionView>
                    <CollectionView.ItemsSource>
                        <x:Array Type="{x:Type model:Person }">
                            <model:Person Name="Steve" Age="21" Location="USA" />
                            <model:Person Name="John" Age="37" Location="USA" />
                            <model:Person Name="Tom" Age="42" Location="UK" />
                            <model:Person Name="Lucas" Age="29" Location="Germany" />
                            <model:Person Name="Tariq" Age="39" Location="UK" />
                            <model:Person Name="Jane" Age="30" Location="USA" />
                        </x:Array>
                    </CollectionView.ItemsSource>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Person">
                            <HorizontalStackLayout>
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding Age}" />
                                <Label Grid.Column="2" Text="{Binding Location}" HorizontalTextAlignment="End" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
            <Label Text="説明"/>
            <Border>
                <VerticalStackLayout>
                    <Border BackgroundColor="AliceBlue">
                        <Label Text="お呼び出し時ご不在の方"/>
                    </Border>
                    <Border>
                        <FlexLayout Direction="Column" Wrap="Wrap"  JustifyContent="SpaceEvenly" BindableLayout.ItemsSource="{Binding Called}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:Int32">
                                        <Border Margin="8" Padding="4" Background="#C86262" StrokeThickness="0" MaximumWidthRequest="100">
                                            <Label Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

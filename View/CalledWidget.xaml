<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:CounterInfo.View"
             x:Class="CounterInfo.View.CalledWidget"
             x:DataType="self:CalledWidgetViewModel">
    <ContentView.BindingContext>
        <self:CalledWidgetViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Gray600}"/>
            <Setter Property="Stroke" Value="{StaticResource Gray600Brush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextColor" Value="{StaticResource White}"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
        </Style>        
    </ContentView.Resources>

    <VerticalStackLayout>
        <Border>
            <Label Text="お呼び出し時ご不在の方"/>
        </Border>
        <Border>
            <FlexLayout Wrap="Wrap" AlignContent="Start" JustifyContent="SpaceBetween"
                        BindableLayout.ItemsSource="{Binding Source, Mode=OneWay}"
                        BackgroundColor="{StaticResource White}" Padding="4,10,4,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:Int32">
                        <Border BackgroundColor="{StaticResource Tertiary}" StrokeThickness="0"
                                HeightRequest="30" WidthRequest="90"
                                Margin="4,0,4,4">
                            <Label Text="{Binding}"/>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>

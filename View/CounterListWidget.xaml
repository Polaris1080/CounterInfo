<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:CounterInfo.View"
             x:Class="CounterInfo.View.CounterListWidget"
             x:DataType="self:CounterListWidgetViewModel">
    <ContentView.BindingContext>
        <self:CounterListWidgetViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource Gray600}"/>
            <Setter Property="Stroke" Value="{StaticResource Gray600Brush}"/>
            <Setter Property="StrokeThickness" Value="2"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="TextColor" Value="{StaticResource White}"/>
            <Setter Property="VerticalTextAlignment" Value="Center"/>
        </Style>        
    </ContentView.Resources>

    <VerticalStackLayout>
        <Border>
            <Label Text="窓口一覧"/>
        </Border>
        <Border>
            <VerticalStackLayout 
                        BindableLayout.ItemsSource="{Binding Source, Mode=OneWay}"
                        BackgroundColor="{StaticResource White}" Padding="4,10,4,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="self:CounterListWidgetData">
                        <HorizontalStackLayout>
                            <Border BackgroundColor="{StaticResource Tertiary}" StrokeThickness="0"
                                    HeightRequest="30" WidthRequest="90"
                                    Margin="4,0,4,4">
                                <Label Text="{Binding Name}"/>
                            </Border>
                            <Button ImageSource="up_icon_white.png" Command="{Binding UpCommand}"/>
                            <Button ImageSource="down_icon_white.png"/>
                            <Button ImageSource="remove_icon_white.png"/>
                        </HorizontalStackLayout>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:CounterInfo.View"
             xmlns:model="clr-namespace:CounterInfo.Models"
             x:Class="CounterInfo.View.CounterInfomationWidget"
             x:DataType="self:CounterInfomationWidgetViewModel">
    <ContentView.BindingContext>
        <self:CounterInfomationWidgetViewModel/>
    </ContentView.BindingContext>

    <VerticalStackLayout HorizontalOptions="Center">
        <CollectionView ItemsSource="{Binding Source}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:CounterInfoData">
                    <HorizontalStackLayout>
                        <Label Text="{Binding Detail}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="{Binding Waiting}" />
                        <Label Grid.Column="2" Text="{Binding Number}" HorizontalTextAlignment="End" />
                        <Label Grid.Column="3" Text="{Binding Estimate}" HorizontalTextAlignment="End" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>

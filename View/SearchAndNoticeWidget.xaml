<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:CounterInfo.View"
             x:Class="CounterInfo.View.SearchAndNoticeWidget"
             x:DataType="self:SearchAndNoticeWidgetViewModel">
    <ContentView.BindingContext>
        <self:SearchAndNoticeWidgetViewModel/>
    </ContentView.BindingContext>





    <VerticalStackLayout BackgroundColor="{StaticResource Secondary}" 
                                       Padding="16,8,8,8" Spacing="8" HorizontalOptions="Center">
        
            <HorizontalStackLayout>
                <Entry Keyboard="Numeric" Text="{Binding Search, Mode=TwoWay}" WidthRequest="100"
                                   BackgroundColor="White"
                                   Margin="0,8,0,0"/>
                <Button Text="検索" ContentLayout="Left" ImageSource="search_icon_white.png"
                                    Command="{Binding SearchCommand}"/>                
            </HorizontalStackLayout>

            <Label Text="{Binding Status, Mode=OneWay}" MinimumWidthRequest="100" MaximumWidthRequest="200"/>

    </VerticalStackLayout>
</ContentView>

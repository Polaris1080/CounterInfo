<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CounterInfo.ViewModels"
             x:Class="CounterInfo.View.SearchAndNoticeWidget"
             x:DataType="vm:SearchAndNoticeWidgetViewModel">
    <ContentView.BindingContext>
        <vm:SearchAndNoticeWidgetViewModel/>
    </ContentView.BindingContext>





    <HorizontalStackLayout BackgroundColor="{StaticResource Secondary}" 
                                       Padding="16,8,8,8" Spacing="8" HorizontalOptions="Center">
        <VerticalStackLayout Spacing="20">
            <Entry Keyboard="Numeric" Text="{Binding Search, Mode=TwoWay}" WidthRequest="100"
                               BackgroundColor="White"
                               Margin="0,8,0,0"/>
            <Label Text="{Binding Status, Mode=OneWay}" MinimumWidthRequest="100" MaximumWidthRequest="200"/>
        </VerticalStackLayout>
        <VerticalStackLayout>
            <Button Text="検索" ContentLayout="Left" ImageSource="search_icon_white.png"
                                Command="{Binding SearchCommand}"/>
            <Button Text="通知" ContentLayout="Left" ImageSource="add_alert_icon_white.png"
                                Command="{Binding NoticeCommand}"/>
        </VerticalStackLayout>
    </HorizontalStackLayout>
</ContentView>

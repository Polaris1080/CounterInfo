<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self="clr-namespace:CounterInfo.View"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CounterInfo.View.NumberSearchWidget"
             x:DataType="self:NumberSearchWidgetViewModel">
    <ContentView.BindingContext>
        <self:NumberSearchWidgetViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Green" />
        </Style>
    </ContentView.Resources>

    <Border Stroke="{StaticResource Gray300Brush}" StrokeThickness="2" HorizontalOptions="Center">
        <VerticalStackLayout BackgroundColor="{StaticResource Secondary}" Padding="10,10,2,8" Spacing="8">
            <HorizontalStackLayout>                
                <Entry Keyboard="Numeric" Text="{Binding Search, Mode=TwoWay}" Placeholder="受付番号"
                       BackgroundColor="White" WidthRequest="100" Margin="0,0,2,0">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior Flags="ValidateOnValueChanged"
                            InvalidStyle="{StaticResource InvalidEntryStyle}" ValidStyle="{StaticResource ValidEntryStyle}"
                            MinimumValue="1" MaximumValue="9999" MaximumDecimalPlaces="0" />
                        </Entry.Behaviors>
                    </Entry>
                <Button Text="検索" ContentLayout="Left" ImageSource="search_icon_white.png"
                        Command="{Binding SearchCommand}" VerticalOptions="Center"/>                
            </HorizontalStackLayout>
            <Label Text="{Binding Status, Mode=OneWay}"/>
        </VerticalStackLayout>        
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns  ="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:self   ="clr-namespace:CounterInfo.View"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class   ="CounterInfo.View.NumberSearchWidget"
             x:DataType="self:NumberSearchWidgetViewModel">
    <ContentView.BindingContext>
        <self:NumberSearchWidgetViewModel/>
    </ContentView.BindingContext>
    <ContentView.Resources>
        <!-- 枠線の太さ -->
        <x:Int32 x:Key="BorderThickness">2</x:Int32>
        <!-- 入力欄の最大値 -->
        <x:Int32 x:Key="NumberMin">1</x:Int32>
        <!-- 入力欄の最小値 -->
        <x:Int32 x:Key="NumberMax">9999</x:Int32>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Red"  />
        </Style>
        <Style x:Key=  "ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="Green"/>
        </Style>
    </ContentView.Resources>

    <Border Stroke="{StaticResource Gray300Brush}" StrokeThickness="{StaticResource BorderThickness}"
            HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout BackgroundColor="{StaticResource Secondary}" Padding="10,10,2,8" Spacing="8">
            <HorizontalStackLayout>
                <Entry Keyboard="Numeric" Text="{Binding Query, Mode=TwoWay}" Placeholder="受付番号"
                       BackgroundColor="White" WidthRequest="100" Margin="0,0,2,0">
                    <Entry.Behaviors>
                        <toolkit:NumericValidationBehavior Flags="ValidateOnValueChanged"
                            InvalidStyle="{StaticResource InvalidEntryStyle}" ValidStyle="{StaticResource ValidEntryStyle}"
                            MinimumValue="{StaticResource NumberMin}" MaximumValue="{StaticResource NumberMax}" MaximumDecimalPlaces="0" />
                    </Entry.Behaviors>
                </Entry>
                <Button Text="検索" ContentLayout="Left" ImageSource="search_icon_white.png" VerticalOptions="Center"
                        Command="{Binding SearchCommand}" IsEnabled="{Binding SearchButtonEnable}"/>
            </HorizontalStackLayout>
            <Label Text="{Binding Result, Mode=OneWay}"/>
        </VerticalStackLayout>
    </Border>
</ContentView>
